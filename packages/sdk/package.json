{
  "name": "@pulse/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Unified LLM client wrapper with built-in inference logging",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "groq-sdk": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
