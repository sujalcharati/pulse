<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="Pulse architecture" id="pulse-arch">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="Pulse — End-to-end data flow&#xa;(one chat turn from browser to dashboard)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="40" as="geometry" />
        </mxCell>

        <!-- ============ ROW 1: USER ============ -->
        <mxCell id="user" value="👤  User&#xa;(browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- ============ ROW 2: CHAT APP (Next.js) ============ -->
        <mxCell id="chat-container" value="apps/chat   (Next.js — port 3000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999;dashed=1;fontSize=12;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="640" height="280" as="geometry" />
        </mxCell>

        <mxCell id="chat-ui" value="React UI&#xa;chat-shell.tsx&#xa;sidebar.tsx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="120" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="api-route" value="POST /api/chat&#xa;route.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sdk-box" value="@pulse/sdk  (same process)&#xa;&#xa;client.ts — chat / chatStream&#xa;provider adapter (gemini/groq)&#xa;LogBuffer + HttpTransport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="chat-explainer" value="The SDK runs INSIDE the chat app's Node process.&#xa;It's an npm workspace package, not a server." style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="280" y="220" width="580" height="30" as="geometry" />
        </mxCell>

        <mxCell id="postgres-arrow-label" value="conversations + messages&#xa;(chat history — source of truth&#xa;for what the UI renders)" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="280" y="260" width="290" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sdk-explainer" value="On every call: stamps trace_id,&#xa;measures latency + TTFT, builds&#xa;a LogEvent, pushes to buffer.&#xa;Logging is fire-and-forget." style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="610" y="240" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ============ POSTGRES ============ -->
        <mxCell id="postgres" value="🐘  Postgres&#xa;(port 5432)&#xa;&#xa;conversations&#xa;messages" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="420" width="130" height="120" as="geometry" />
        </mxCell>

        <!-- ============ EXTERNAL LLM ============ -->
        <mxCell id="llm" value="☁️  LLM Providers&#xa;(external)&#xa;&#xa;Gemini API&#xa;Groq API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="120" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- ============ INGESTION SERVICE ============ -->
        <mxCell id="ingestion-container" value="apps/ingestion   (Fastify — port 4000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999;dashed=1;fontSize=12;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="940" y="280" width="500" height="280" as="geometry" />
        </mxCell>

        <mxCell id="ingest-http" value="POST /v1/logs&#xa;(http/server.ts)&#xa;&#xa;1. Zod-validate batch&#xa;2. XADD each event&#xa;3. Return 202" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="970" y="320" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ingest-worker" value="ConsumerWorker&#xa;(consumer/worker.ts)&#xa;&#xa;Loop:&#xa;1. XREADGROUP BLOCK&#xa;2. Zod-validate again&#xa;3. redactPii(previews)&#xa;4. ClickHouse insert&#xa;5. XACK on success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="320" width="220" height="170" as="geometry" />
        </mxCell>

        <!-- ============ REDIS ============ -->
        <mxCell id="redis" value="🔴  Redis Streams&#xa;(port 6379)&#xa;&#xa;pulse:logs&#xa;(consumer group)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="600" width="150" height="120" as="geometry" />
        </mxCell>

        <!-- ============ CLICKHOUSE ============ -->
        <mxCell id="clickhouse" value="⚡  ClickHouse&#xa;(port 8123)&#xa;&#xa;inference_logs&#xa;inference_logs_1m (MV)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="600" width="170" height="120" as="geometry" />
        </mxCell>

        <!-- ============ GRAFANA ============ -->
        <mxCell id="grafana" value="📊  Grafana&#xa;(port 3001)&#xa;&#xa;Dashboards:&#xa;p50/p95/p99 latency&#xa;errors by provider&#xa;tokens / cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="780" width="170" height="160" as="geometry" />
        </mxCell>

        <!-- ============ ENGINEER ============ -->
        <mxCell id="engineer" value="👷  Engineer&#xa;(views dashboards)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="820" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- ============ ARROWS ============ -->

        <!-- user -> chat ui -->
        <mxCell id="a1" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="user" target="chat-ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1l" value="① types message" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="a1">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>

        <!-- chat ui -> api route -->
        <mxCell id="a2" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="chat-ui" target="api-route">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2l" value="② fetch /api/chat&#xa;(ndjson stream)" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="a2">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- api route -> sdk -->
        <mxCell id="a3" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="api-route" target="sdk-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3l" value="③ pulse.chatStream()" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- api route -> postgres -->
        <mxCell id="a4" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="api-route" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4l" value="④ insert user msg&#xa;load history&#xa;insert assistant msg" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="a4">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>

        <!-- sdk -> llm -->
        <mxCell id="a5" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="sdk-box" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5l" value="⑤ HTTPS to provider&#xa;(streaming SSE)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- sdk -> ingestion http -->
        <mxCell id="a6" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.3;strokeWidth=2;dashed=1;" edge="1" parent="1" source="sdk-box" target="ingest-http">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6l" value="⑥ batched LogEvents&#xa;POST /v1/logs every 1s&#xa;(fire-and-forget)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="a6">
          <mxGeometry x="-0.4" relative="1" as="geometry" />
        </mxCell>

        <!-- ingest http -> redis -->
        <mxCell id="a7" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="ingest-http" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7l" value="⑦ XADD" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="a7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- redis -> worker -->
        <mxCell id="a8" style="endArrow=classic;html=1;exitX=1;exitY=0.3;entryX=0.5;entryY=1;strokeWidth=2;" edge="1" parent="1" source="redis" target="ingest-worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8l" value="⑧ XREADGROUP" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="a8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- worker -> clickhouse -->
        <mxCell id="a9" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;strokeWidth=2;" edge="1" parent="1" source="ingest-worker" target="clickhouse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a9l" value="⑨ bulk insert&#xa;(JSONEachRow)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="a9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- clickhouse -> grafana -->
        <mxCell id="a10" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="clickhouse" target="grafana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a10l" value="⑩ SELECT (dashboards)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="a10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- engineer -> grafana -->
        <mxCell id="a11" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="engineer" target="grafana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ LEGEND ============ -->
        <mxCell id="legend-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#ccc;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="540" height="340" as="geometry" />
        </mxCell>

        <mxCell id="legend-title" value="Legend / Reading Order" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="610" width="500" height="24" as="geometry" />
        </mxCell>

        <mxCell id="legend-text" value="① User types a message in the browser.&#xa;② Browser POSTs to /api/chat — Next.js streams the response back as ndjson.&#xa;③ The API route calls the SDK's chatStream() — SDK lives in the same Node process.&#xa;④ Around the SDK call, the route writes the user msg and (when done) the assistant msg to Postgres.&#xa;⑤ SDK opens a streaming HTTPS request to Gemini or Groq. Each delta is forwarded to the browser.&#xa;⑥ When the call ends, SDK builds a LogEvent and pushes it to an in-memory buffer.&#xa;       Every 1s a flush tick POSTs the batch to the ingestion service. If POST fails: exponential backoff.&#xa;⑦ Ingestion validates the batch with Zod, then XADDs each event onto a Redis Stream (pulse:logs).&#xa;⑧ A worker on the same process reads from the stream via XREADGROUP (consumer groups = at-least-once).&#xa;⑨ Worker validates again, redacts PII (emails / keys / phones) in previews, bulk-inserts into ClickHouse,&#xa;       then XACKs the entries. If the CH insert fails, it does NOT ack → Redis re-delivers next loop.&#xa;⑩ Grafana queries ClickHouse (raw table + a 1-minute materialized view rollup) to draw the dashboards." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="500" height="290" as="geometry" />
        </mxCell>

        <!-- ============ KEY DECISIONS BOX ============ -->
        <mxCell id="dec-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="420" height="340" as="geometry" />
        </mxCell>

        <mxCell id="dec-title" value="Why the design looks like this" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="610" width="380" height="24" as="geometry" />
        </mxCell>

        <mxCell id="dec-text" value="• Postgres for chat, ClickHouse for telemetry.&#xa;   Postgres is great at &quot;last 20 msgs for convo X&quot;.&#xa;   ClickHouse is great at &quot;p95 latency by provider, last 24h&quot;.&#xa;   Trying to do both in one DB = slow chats OR slow dashboards.&#xa;&#xa;• SDK logs are fire-and-forget.&#xa;   A logging outage must never break the user's chat call.&#xa;   So: in-memory buffer, drop-oldest if full, retry with backoff.&#xa;&#xa;• Redis Streams between HTTP and ClickHouse.&#xa;   Decouples accepting events (fast, must not lose them)&#xa;   from inserting events (slow, batch-friendly).&#xa;   At-least-once delivery via XACK after successful insert.&#xa;&#xa;• PII redaction on the consumer side, not the SDK.&#xa;   SDK ships raw → ingestion is the trust boundary that&#xa;   decides what's safe to persist. Single place to update rules.&#xa;&#xa;• trace_id flows everywhere (SDK → Postgres → ClickHouse).&#xa;   Lets you jump from a Grafana row back to the actual chat." style="text;html=1;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="660" y="640" width="380" height="290" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
