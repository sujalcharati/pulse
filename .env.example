# =====================================================================
# Pulse — environment configuration
# Copy to .env and fill in. NEVER commit .env to git.
# =====================================================================

# ---- LLM provider keys -----------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: only if you want to demo with a frontier model
ANTHROPIC_API_KEY=

# ---- Postgres (operational data: conversations, messages) -----------
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password
POSTGRES_DB=pulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pulse:pulse_dev_password@localhost:5432/pulse

# ---- ClickHouse (analytics data: inference logs) --------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=pulse

# ---- Redis (event-driven ingestion queue) ---------------------------
REDIS_URL=redis://localhost:6379
REDIS_STREAM_KEY=pulse:inference-logs
REDIS_CONSUMER_GROUP=ingestion-workers

# ---- SDK / services -------------------------------------------------
# Where the SDK ships logs to (HTTP fallback if Redis unavailable)
PULSE_INGEST_URL=http://localhost:4000/v1/logs
INGESTION_PORT=4000

# Where the chat app runs
CHAT_PORT=3000

# ---- Grafana --------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
