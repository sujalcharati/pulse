{
  "name": "@pulse/ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse ingestion service: HTTP receiver + Redis Streams consumer + ClickHouse writer",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clickhouse/client": "^1.7.0",
    "@pulse/sdk": "*",
    "dotenv": "^16.4.5",
