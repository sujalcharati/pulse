{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight LLM inference logging + ingestion platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:chat": "npm --workspace apps/chat run dev",
    "dev:ingestion": "npm --workspace apps/ingestion run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20"
  }
}
